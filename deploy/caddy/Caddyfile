# Публичный вход в веб-интерфейс поиска. Сертификат Let's Encrypt Caddy
# получает и продлевает сам: нужны порты 80 и 443 снаружи и A-запись домена
# на этот сервер. Пароль и сессии — в самом сервисе (docs/web.md).
sudrfapp.ru {
	# Только внешний адрес сервера: на 127.0.0.1:443 уже слушает туннель
	# сбора КС РФ (docs/ksrf.md), и общий `:443` с ним не уживётся.
	bind 157.22.194.96
	encode zstd gzip
	# Журнала запросов нет намеренно: в адресах — слова поиска.
	log {
		output discard
	}
	reverse_proxy 127.0.0.1:8766
}
