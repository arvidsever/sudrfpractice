[Unit]
Description=Свод карточек дел КСОЮ
Documentation=file:///srv/sudrfpractice/docs/roadmap.md

[Service]
Type=oneshot
User=sudrf
WorkingDirectory=/srv/sudrfpractice
# Объём выбран владельцем 27.08.2026: дела со ссылкой на акт с 2025 года.
# Прайс-лист остальных вариантов — docs/roadmap.md, этап 5.
ExecStart=/srv/sudrfpractice/.venv/bin/python -m harvester cards --all --with-act --since 01.01.2025
# Прогон сам выходит, когда все суды придержаны; таймер поднимет снова.
# Второй заход не начнётся: харвестер держит flock на машину.
TimeoutStartSec=infinity

# Шесть часов и на выход — не от зависаний, а чтобы отпускать замок.
# Свод идёт неделю подряд и держит его непрерывно, поэтому суточный добег
# 30.08.2026 простоял в очереди сутки с лишним и не выполнился ни разу:
# «умирает» починили, а «ждёт вечно» получили. Обрыв ничего не стоит —
# свод возобновляемый, берутся дела с непроставленным card_fetched_at, —
# зато между заходами появляется окно, в которое добег успевает.
RuntimeMaxSec=6h
