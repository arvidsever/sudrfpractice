[Unit]
Description=КАД: непрерывный сбор (6 ч работы, 3 ч паузы, по кругу)
Documentation=file:///srv/sudrfpractice/docs/kad.md

[Service]
Type=simple
User=sudrf
WorkingDirectory=/srv/sudrfpractice
# Цикл 6+3 часа: старт сдвигается от суток к суткам, картина запросов
# не повторяется. Замок КАД свой, другие обходы не блокирует.
ExecStart=/srv/sudrfpractice/.venv/bin/python /srv/sudrfpractice/scripts/kad_loop.py
Restart=always
RestartSec=60
# 75 — «замок у другого обхода, не сейчас». При непрерывном сервисе это
# не фатально: цикл повторится после паузы.
SuccessExitStatus=75
ExecStopPost=-/srv/sudrfpractice/.venv/bin/python -m harvester alert %n
StateDirectory=sudrf

[Install]
WantedBy=multi-user.target
