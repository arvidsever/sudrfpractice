[Unit]
Description=Поднимать сбор КАД раз в сутки

[Timer]
# После добега (05:00–05:43): запуск браузера под cookie и PDF-перехваты
# не совпадают с худшим часом остального сбора.
# 6 часов сбора, 3 часа паузы, 6 часов сбора, 3 часа паузы, 6 часов сбора —
# итого ~18 часов в сутки. Паузы нужны, чтобы КАД не видел непрерывный
# поток с наших адресов: так меньше шанс бана по объёму, чем при 24/7.
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 15:30:00
OnCalendar=*-*-* 00:30:00
# Пропущенный из-за простоя запуск наверстать: без перепросмотра окна
# стареют (RECOUNT_DAYS) и всё равно потребуют тех же запросов.
Persistent=true

[Install]
WantedBy=timers.target
