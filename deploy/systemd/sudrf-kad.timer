[Unit]
Description=Поднимать сбор КАД раз в сутки

[Timer]
# После добега (05:00–05:43): запуск браузера под cookie и PDF-перехваты
# не совпадают с худшим часом остального сбора.
# Два прогона по 6 часов с паузой 3 часа между ними и 9 часами паузы на ночь:
# 06:30–12:30 и 15:30–21:30. Три прогона по 6 часов в сутки не влезают
# с 3-часовыми паузами (6+3+6+3+6 = 24, паузы между последним и первым
# не остаётся), поэтому третий прогон пришлось бы укорачивать. Если нужно
# больше часов — см. docs/kad.md: три прогона по 5 часов.
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 15:30:00
# Пропущенный из-за простоя запуск наверстать: без перепросмотра окна
# стареют (RECOUNT_DAYS) и всё равно потребуют тех же запросов.
Persistent=true

[Install]
WantedBy=timers.target
