[Unit]
Description=ВС РФ: выдачи актов и производств-«дел»
Documentation=file:///srv/sudrfpractice/docs/vsrf.md

[Service]
Type=oneshot
User=sudrf
WorkingDirectory=/srv/sudrfpractice
# Свой замок и своя общая пауза — платформа ВС, а не ГАС: идёт параллельно
# со сводом КСОЮ, ничего у него не отнимая. Экономическая коллегия не берётся.
# Тексты — отдельным заданием sudrf-vsrf-texts, вторым потоком.
ExecStart=/srv/sudrfpractice/.venv/bin/python -m harvester vsrf --only listings
TimeoutStartSec=7h
SuccessExitStatus=75
ExecStopPost=-/srv/sudrfpractice/.venv/bin/python -m harvester alert %n
StateDirectory=sudrf
